# ─────────────────────────────────────────────────────────────────────────────
# noxwork-gedcom-web — Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ── Backend API ───────────────────────────────────────────────────────────────
# Leave unset for local development — the Vite dev server proxy rewrites /api
# to http://localhost:3000 automatically.
# For production (Vercel), set this in the Vercel dashboard to your deployed
# NestJS backend URL (no trailing slash, no /api suffix).
# VITE_API_URL="https://noxwork-gedcom-api.railway.app"

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth setup (in Supabase Dashboard):
#   Authentication → Providers → Google → Enable
#   Authorized redirect URI → https://your-project-ref.supabase.co/auth/v1/callback
#
# In Google Cloud Console → OAuth 2.0 Credentials → Authorized redirect URIs:
#   http://localhost:5173/auth/callback       (dev)
#   https://gedcom.noxwork.net/auth/callback  (prod)
# ─────────────────────────────────────────────────────────────────────────────
