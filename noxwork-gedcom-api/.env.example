# ─────────────────────────────────────────────────────────────────────────────
# noxwork-gedcom-api — Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma ORM.
# Local:       postgresql://USER:PASSWORD@localhost:5432/noxwork_gedcom
# Production:  Get from Neon.tech → Project → Connection Details → Pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Required for JWKS verification of Supabase-issued JWTs.
# Get it from: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL="https://your-project-id.supabase.co"

# ── Server ────────────────────────────────────────────────────────────────────
# Port the NestJS server listens on.
# Railway.app sets this automatically; leave blank to default to 3000.
PORT=3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:5173
# Production:   http://localhost:5173,https://noxwork-gedcom.vercel.app
CORS_ORIGIN="http://localhost:5173"
